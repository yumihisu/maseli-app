rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function esDueno(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function perfilValido(d) {
      return d.nombre is string && d.nombre.size() > 0 && d.nombre.size() <= 60
        && d.residencia is string && d.residencia.size() > 0 && d.residencia.size() <= 80;
    }

    function reporteValido(d) {
      return d.tipo in ['avisos', 'limpieza', 'mantenimiento']
        && d.especialidad is string && d.especialidad.size() > 0 && d.especialidad.size() <= 30
        && d.piso is string && d.piso.size() > 0 && d.piso.size() <= 20
        && d.depto is string && d.depto.size() > 0 && d.depto.size() <= 40
        && d.descripcion is string && d.descripcion.size() >= 5 && d.descripcion.size() <= 600
        && d.prioridad in ['normal', 'urgente']
        && d.estado in ['pendiente', 'visto', 'en_progreso', 'completado', 'cancelado']
        && d.fecha is string && d.hora is string;
    }

    // Perfil del residente: solo su dueño (usuario anónimo) puede leerlo o escribirlo
    match /residentes/{uid} {
      allow read: if esDueno(uid);
      allow create, update: if esDueno(uid) && perfilValido(request.resource.data);
      allow delete: if false;
    }

    // Reportes: cada residente solo ve y modifica los suyos
    match /reportes/{reporteId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && reporteValido(request.resource.data);
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && reporteValido(request.resource.data);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Todo lo demás, cerrado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
